INGEST_GRPC_ENDPOINT=http://127.0.0.1:10000
INGEST_DATABASE_URL=postgres://root@127.0.0.1:26257/das?sslmode=disable
INGEST_STATE_DIR=/var/lib/das-grpc-ingester
INGEST_CONCURRENCY=64
INGEST_DATABASE_MAX_CONNECTIONS=64
# INGEST_START_SLOT=
# INGEST_METADATA_DISABLE=true
# IPFS gateway for ipfs:// URIs. Point at your own; then also rewrite public gateways.
INGEST_IPFS_GATEWAY=https://ipfs.io
# INGEST_IPFS_REWRITE_PUBLIC_GATEWAYS=true
# INGEST_METADATA_PER_HOST_CONCURRENCY=8
# INGEST_METADATA_MAX_ATTEMPTS=5
# INGEST_METADATA_REDRIVE_INTERVAL_SECS=300
RUST_LOG=info,sqlx::query=warn
